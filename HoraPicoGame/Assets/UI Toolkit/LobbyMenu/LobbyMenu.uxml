<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/general.uss?fileID=7433441132597879392&amp;guid=f5a0ee328dd0c4845b21842990c8668c&amp;type=3#general"/>
    <ui:VisualElement style="flex-grow: 1; flex-direction: column; align-content: flex-end; justify-content: flex-end;">
        <ui:VisualElement name="" style="flex-grow: 1; align-items: stretch; flex-direction: row; justify-content: space-around;">
            <ui:VisualElement style="flex-grow: 1; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; background-color: rgba(116, 65, 0, 0.39);">
                <ui:Label text="Traffic" class="title" style="-unity-text-align: upper-center;"/>
                <ui:Button text="Join&#10;" name="btnJoinTraffic" class="primaryButton"/>
                <ui:VisualElement name="trafficContainer" style="flex-grow: 1;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; background-color: rgba(23, 140, 0, 0.39);">
                <ui:Label text="Police" class="title" style="-unity-text-align: upper-center;"/>
                <ui:Button text="Join&#10;" name="btnJoinPolice" class="primaryButton"/>
                <ui:VisualElement name="policeContainer" style="flex-grow: 1; flex-direction: row;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 0; background-color: rgba(0, 0, 0, 0.39); flex-direction: row; align-items: center;">
            <ui:Label text="Unassigned:" class="subTitle"/>
            <ui:VisualElement name="unassignedContainer" style="flex-grow: 1; flex-direction: row;">
                <ui:Image source="project://database/Assets/UI%20Toolkit/LobbyMenu/mouse.png.png?fileID=2800000&amp;guid=dc4fa24a950605b42ad472c67541c165&amp;type=3#mouse.png" class="mouseImage"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 0; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; background-color: rgba(0, 0, 0, 0.39);">
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: center; align-items: center;">
                <ui:Label text="Room ID:&#10;" style="-unity-text-align: upper-center; color: rgb(255, 255, 255); -unity-font-style: bold;"/>
                <ui:Label text="1234-1234-1234" name="roomId" style="-unity-font-style: bold; color: rgb(255, 255, 255);"/>
                <ui:Button text="Copy&#10;" name="copyTextBtn" class="secondaryButton"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 0; flex-direction: row; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-left-color: rgba(0, 0, 0, 0.39); border-right-color: rgba(0, 0, 0, 0.39); border-top-color: rgba(0, 0, 0, 0.39); border-bottom-color: rgba(0, 0, 0, 0.39); background-color: rgba(0, 0, 0, 0); justify-content: center; align-items: center;">
                <ui:Button text="Start Game&#10;" name="btnStartGame" class="primaryButton"/>
                <ui:Button text="Close Room&#10;" name="btnCloseRoom" class="primaryButton"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
